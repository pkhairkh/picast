# boGDan Configuration File
#
# Copy to one of these locations:
#   ./bogdan.toml
#   /etc/bogdan/bogdan.toml
#   /usr/local/etc/bogdan/bogdan.toml
#
# Or set BOGDAN_CONFIG=/path/to/bogdan.toml
#
# Environment variables (BOGDAN_*) override config file values.

[server]
# HTTP REST API listen address.
http_addr = "0.0.0.0:8585"
# WebSocket server listen address.
ws_addr = "0.0.0.0:8586"
# Session database path (SQLite).
db_path = "/var/lib/bogdan/sessions.db"
# TLS certificate path (PEM). Set both cert and key to enable HTTPS/WSS.
tls_cert_path = "/etc/bogdan/tls/bogdan.pem"
# TLS private key path (PEM). Set both cert and key to enable HTTPS/WSS.
tls_key_path = "/etc/bogdan/tls/bogdan-key.pem"

[tor]
# Tor SOCKS5 proxy address.
socks_addr = "127.0.0.1:9050"
# Tor control port.
control_port = 9051
# Tor control authentication cookie path.
cookie_path = "/run/tor/control.authcookie"

[display]
# DRM device path (empty = auto-detect, "mock" = no hardware).
drm_device = ""

[playback]
# ALSA audio output device. Empty = ALSA default.
# Common values on Raspberry Pi:
#   "plughw:0,0"  — Headphones (3.5mm jack)
#   "plughw:1,0"  — HDMI 0 (vc4hdmi0)
#   "plughw:2,0"  — HDMI 1 (vc4hdmi1)
# Use "plughw" (not "hw") so ALSA can convert formats.
# Override with BOGDAN_AUDIO_DEVICE env var.
audio_device = ""

[dlna]
# Friendly name advertised on the local network via SSDP.
friendly_name = "boGDan"
# DLNA renderer listen port.
port = 49152

[logging]
# Log level: trace, debug, info, warn, error
level = "info"
