#!/bin/bash
# PiCast post-install script
set -e

case "$1" in
    configure)
        # Create picast system user if it doesn't exist
        if ! id -u picast >/dev/null 2>&1; then
            useradd -r -m -s /usr/sbin/nologin picast
            echo "picast: Created system user"
        fi

        # Add picast user to required groups (idempotent)
        usermod -aG video,render,audio picast

        # Create data directory
        mkdir -p /var/lib/picast
        chown picast:picast /var/lib/picast

        # Create temp directory
        mkdir -p /tmp/picast/subs
        chown picast:picast /tmp/picast

        # Install iptables rules if available
        if [ -f /etc/picast/iptables.rules ]; then
            if command -v iptables-restore >/dev/null 2>&1; then
                iptables-restore < /etc/picast/iptables.rules
                echo "picast: Firewall rules applied"
            fi
            # Persist rules if iptables-persistent is available
            if command -v netfilter-persistent >/dev/null 2>&1; then
                netfilter-persistent save >/dev/null 2>&1 || true
            fi
        fi

        # Configure Tor if available
        if [ -f /etc/picast/torrc ]; then
            if [ -d /etc/tor ]; then
                # Back up existing torrc before overwriting
                if [ -f /etc/tor/torrc ]; then
                    cp -a /etc/tor/torrc /etc/tor/torrc.picast-backup 2>/dev/null || true
                fi
                cp /etc/picast/torrc /etc/tor/torrc
                chmod 644 /etc/tor/torrc
                if command -v systemctl >/dev/null 2>&1; then
                    systemctl restart tor 2>/dev/null || true
                    systemctl enable tor 2>/dev/null || true
                fi
                echo "picast: Tor configured"
            fi
        fi

        # Enable systemd service
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload
            systemctl enable picast 2>/dev/null || true
            echo "picast: Service enabled (start with: systemctl start picast)"
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        ;;
esac

exit 0
