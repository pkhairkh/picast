#!/bin/bash
# boGDan post-install script
set -e

case "$1" in
    configure)
        # Create bogdan system user if it doesn't exist
        if ! id -u bogdan >/dev/null 2>&1; then
            useradd -r -m -s /usr/sbin/nologin bogdan
            echo "bogdan: Created system user"
        fi

        # Add bogdan user to required groups (idempotent)
        usermod -aG video,render,audio bogdan

        # Create data directory
        mkdir -p /var/lib/bogdan
        chown bogdan:bogdan /var/lib/bogdan

        # Create temp directory
        mkdir -p /tmp/bogdan/subs
        chown bogdan:bogdan /tmp/bogdan

        # Install iptables rules if available
        if [ -f /etc/bogdan/iptables.rules ]; then
            if command -v iptables-restore >/dev/null 2>&1; then
                iptables-restore < /etc/bogdan/iptables.rules
                echo "bogdan: Firewall rules applied"
            fi
            # Persist rules if iptables-persistent is available
            if command -v netfilter-persistent >/dev/null 2>&1; then
                netfilter-persistent save >/dev/null 2>&1 || true
            fi
        fi

        # Configure Tor if available
        if [ -f /etc/bogdan/torrc ]; then
            if [ -d /etc/tor ]; then
                # Back up existing torrc before overwriting
                if [ -f /etc/tor/torrc ]; then
                    cp -a /etc/tor/torrc /etc/tor/torrc.bogdan-backup 2>/dev/null || true
                fi
                cp /etc/bogdan/torrc /etc/tor/torrc
                chmod 644 /etc/tor/torrc
                if command -v systemctl >/dev/null 2>&1; then
                    systemctl restart tor 2>/dev/null || true
                    systemctl enable tor 2>/dev/null || true
                fi
                echo "bogdan: Tor configured"
            fi
        fi

        # Enable systemd service
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload
            systemctl enable bogdan 2>/dev/null || true
            echo "bogdan: Service enabled (start with: systemctl start bogdan)"
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        ;;
esac

exit 0
