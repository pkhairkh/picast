#!/bin/bash
# boGDan post-remove script
set -e

case "$1" in
    purge)
        # Disable and remove systemd service
        if command -v systemctl >/dev/null 2>&1; then
            systemctl disable bogdan 2>/dev/null || true
        fi
        if [ -f /etc/systemd/system/bogdan.service ]; then
            rm -f /etc/systemd/system/bogdan.service
            if command -v systemctl >/dev/null 2>&1; then
                systemctl daemon-reload
            fi
        fi

        # Remove bogdan user
        if id -u bogdan >/dev/null 2>&1; then
            userdel bogdan 2>/dev/null || true
            echo "bogdan: Removed system user"
        fi

        # Remove data directory
        if [ -d /var/lib/bogdan ]; then
            rm -rf /var/lib/bogdan
            echo "bogdan: Removed data directory /var/lib/bogdan"
        fi

        # Remove temp directory
        if [ -d /tmp/bogdan ]; then
            rm -rf /tmp/bogdan
        fi

        # Remove config directory
        if [ -d /etc/bogdan ]; then
            rm -rf /etc/bogdan
            echo "bogdan: Removed config directory /etc/bogdan"
        fi
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # On non-purge removal, keep user and data
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        ;;
esac

exit 0
