# /etc/iptables/rules.v4 — PiCast Firewall Configuration
# See SPECIFICATION.md §7 for network security rationale
#
# Apply with: sudo iptables-restore < config/iptables.rules
# Persist with: sudo netfilter-persistent save

*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]

## ─── INPUT Chain ────────────────────────────────────────────

# Allow established connections
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# Allow loopback
-A INPUT -i lo -j ACCEPT

# Allow ICMP (ping) from LAN
-A INPUT -s 192.168.0.0/16 -p icmp --icmp-type 8 -j ACCEPT
-A INPUT -s 10.0.0.0/8 -p icmp --icmp-type 8 -j ACCEPT

# PiCast HTTP API (port 8585) — LAN only
-A INPUT -s 192.168.0.0/16 -p tcp --dport 8585 -j ACCEPT
-A INPUT -s 10.0.0.0/8 -p tcp --dport 8585 -j ACCEPT

# PiCast WebSocket (port 8586) — LAN only
-A INPUT -s 192.168.0.0/16 -p tcp --dport 8586 -j ACCEPT
-A INPUT -s 10.0.0.0/8 -p tcp --dport 8586 -j ACCEPT

# PiCast DLNA MediaRenderer (port 49152) — LAN only
-A INPUT -s 192.168.0.0/16 -p tcp --dport 49152 -j ACCEPT
-A INPUT -s 10.0.0.0/8 -p tcp --dport 49152 -j ACCEPT

# SSDP discovery (multicast UDP port 1900) — LAN only
-A INPUT -s 192.168.0.0/16 -p udp --dport 1900 -j ACCEPT
-A INPUT -s 10.0.0.0/8 -p udp --dport 1900 -j ACCEPT

# mDNS discovery (multicast UDP port 5353) — any source (multicast)
-A INPUT -p udp --dport 5353 -d 224.0.0.251 -j ACCEPT

# SSH from LAN (for administration)
-A INPUT -s 192.168.0.0/16 -p tcp --dport 22 -j ACCEPT
-A INPUT -s 10.0.0.0/8 -p tcp --dport 22 -j ACCEPT

# Log and drop everything else
-A INPUT -m limit --limit 5/min -j LOG --log-prefix "IPTables-Dropped-Input: "
-A INPUT -j DROP

## ─── FORWARD Chain ──────────────────────────────────────────
# Pi is not a router
-A FORWARD -j DROP

## ─── OUTPUT Chain ───────────────────────────────────────────

# Allow established connections
-A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# Allow loopback
-A OUTPUT -o lo -j ACCEPT

# Allow Tor SOCKS proxy (primary — content resolution + media fetching)
-A OUTPUT -d 127.0.0.1/32 -p tcp --dport 9050 -j ACCEPT
# Allow Tor control port (circuit health monitoring + NEWNYM)
-A OUTPUT -d 127.0.0.1/32 -p tcp --dport 9051 -j ACCEPT

# Allow LAN (DLNA, mDNS, SSDP, SSH responses)
-A OUTPUT -d 192.168.0.0/16 -j ACCEPT
-A OUTPUT -d 10.0.0.0/8 -j ACCEPT
-A OUTPUT -d 172.16.0.0/12 -j ACCEPT

# Allow Tor daemon to connect to relay nodes (dynamic ports)
# This must use the UID of the tor process
-A OUTPUT -m owner --uid-owner debian-tor -j ACCEPT

# Allow DNS to localhost (dnsmasq stub resolver that refuses queries)
-A OUTPUT -d 127.0.0.1/32 -p udp --dport 53 -j ACCEPT

# Log and drop everything else
-A OUTPUT -m limit --limit 5/min -j LOG --log-prefix "IPTables-Dropped-Output: "
-A OUTPUT -j DROP

COMMIT
