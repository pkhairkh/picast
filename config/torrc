# /etc/tor/torrc — boGDan Configuration
# See DECISIONS.md ADR-004 for rationale on using C Tor daemon over arti

## ─── SOCKS Ports ───────────────────────────────────────────
# Port 9050: Primary SOCKS5 with per-site stream isolation
# SOCKS5 username determines which circuit to use (IsolateSOCKSAuth)
SocksPort 9050 IsolateSOCKSAuth

# Port 9051: Alternative port with per-destination-IP isolation
# Used by GStreamer when per-IP isolation is preferred
SocksPort 9051 IsolateDestAddr

# Port 29050: boGDan-exclusive SOCKS5 port with per-site isolation.
# Isolates boGDan's Tor circuits from other SOCKS users on the system
# so that video streaming traffic gets dedicated circuits and does not
# compete with (or get throttled by) other Tor traffic.
SocksPort 29050 IsolateSOCKSAuth

## ─── Streaming Optimizations ────────────────────────────────
# Keep circuits alive longer (10 min default is too aggressive for video)
MaxCircuitDirtiness 600

# Fail fast on slow circuits — try another path
CircuitBuildTimeout 30

# Rotate to potentially better circuits periodically
NewCircuitPeriod 120

# Don't enforce entry node restrictions (reduces path diversity)
StrictNodes 0

## ─── Control Port ──────────────────────────────────────────
# Control port for boGDan's TorManager (circuit health, NEWNYM).
# Cookie authentication is required — no password-based auth.
# Restricted to localhost only.
ControlPort 9052
CookieAuthentication 1
CookieAuthFileGroupReadable 1

# Don't run as a relay or exit — client only
ExitRelay 0
PublishServerDescriptor 0

# Disable hidden service functionality (not needed)
HiddenServiceNonAnonymousMode 0

# Reject SOCKS requests to private networks (prevent Tor bypass)
ReachableDirAddresses *:80
ReachableORAddresses *:443

## ─── Logging ────────────────────────────────────────────────
# Minimal logging for production
Log notice syslog

## ─── Performance ────────────────────────────────────────────
# Use more concurrent circuits for adaptive streaming
MaxClientCircuitsPending 32

# Prefer faster nodes for streaming
PathsNeededToBuildCircuits 0.75

## ─── boGDan Streaming Notes ──────────────────────────────────
# IsolateSOCKSAuth on port 9050 means each unique SOCKS5 username
# gets its own circuit. boGDan hashes the hostname to produce the
# username, so different websites never share a circuit.
# Port 9051 uses IsolateDestAddr for GStreamer's souphttpsrc which
# does not support username-based isolation.
