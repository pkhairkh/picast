[Unit]
Description=PiCast Media Receiver
After=network-online.target tor.service
Wants=network-online.target
Requires=tor.service

[Service]
Type=simple
User=picast
Group=picast
SupplementaryGroups=video render audio

# Environment
Environment=DISPLAY=:0
Environment=RUST_LOG=picast=info
Environment=PICAST_HTTP_ADDR=0.0.0.0:8585
Environment=PICAST_WS_ADDR=0.0.0.0:8586
Environment=PICAST_TOR_SOCKS=127.0.0.1:9050

# Main executable
ExecStart=/usr/local/bin/picast

# Notify systemd when ready (sd_notify support)
# Type=notify
# NotifyAccess=all

# Restart policy
Restart=on-failure
RestartSec=5

# Watchdog disabled — requires sd_notify() integration in the Rust binary.
# Enable once NOTIFY_SOCKET support is implemented.
# WatchdogSec=30

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp/picast /var/lib/picast
PrivateTmp=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true

# Resource limits
LimitNOFILE=4096
CPUWeight=80
IOWeight=80

[Install]
WantedBy=multi-user.target
