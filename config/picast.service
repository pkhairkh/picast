[Unit]
Description=PiCast Media Receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=picast
Group=picast
SupplementaryGroups=video render audio

# Release the kernel framebuffer console (fbcon) from the vc4 DRM
# device so that PiCast (and kmssink) can acquire DRM master.
# On Raspberry Pi with vc4, fbcon binds to the DRM device and holds
# DRM master, preventing other processes from acquiring it.  drmSetMaster
# returns EBUSY even with CAP_SYS_ADMIN in current Linux kernels (6.x),
# so the only way to release master is to unbind fbcon first.
# The "-" prefix makes failure non-fatal (e.g. on vkms or systems
# without fbcon).
ExecStartPre=-/bin/sh -c 'for vt in /sys/class/vtconsole/vtcon*/bind; do [ -f "$vt" ] && echo 0 > "$vt" 2>/dev/null; done; true'

# CAP_SYS_ADMIN is kept for potential future use (e.g. DRM auth
# magic).  It does NOT allow stealing DRM master from the console —
# that requires unbinding fbcon via ExecStartPre above.
AmbientCapabilities=CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_SYS_ADMIN

# Environment
Environment=RUST_LOG=picast=info
Environment=HOME=/var/lib/picast
Environment=XDG_CACHE_HOME=/var/lib/picast/.cache
Environment=PICAST_RUNTIME_DIR=/run/picast
Environment=TMPDIR=/run/picast

# Main executable
ExecStart=/usr/local/bin/picast-server --config /etc/picast/picast.toml

# Notify systemd when ready (sd_notify support)
NotifyAccess=all

# Restart policy
Restart=on-failure
RestartSec=5

# Watchdog — the binary sends WATCHDOG=1 every 10 seconds.
# If no heartbeat is received within 30s, systemd restarts the service.
WatchdogSec=30

RuntimeDirectory=picast
RuntimeDirectoryMode=0755
StateDirectory=picast
StateDirectoryMode=0755

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/picast /var/lib/picast /etc/picast
PrivateTmp=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=true

# Resource limits
LimitNOFILE=4096
CPUWeight=80
IOWeight=80

[Install]
WantedBy=multi-user.target
