[Unit]
Description=PiCast Media Receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=picast
Group=picast
SupplementaryGroups=video render audio

# CAP_SYS_ADMIN is needed to call drmSetMaster() when the console
# framebuffer holds DRM master.  Without this, PiCast cannot acquire
# DRM master and kmssink will fail to do modesetting.
AmbientCapabilities=CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_SYS_ADMIN

# Environment
Environment=RUST_LOG=picast=info
Environment=HOME=/var/lib/picast
Environment=XDG_CACHE_HOME=/var/lib/picast/.cache

# Main executable
ExecStart=/usr/local/bin/picast-server --config /etc/picast/picast.toml

# Notify systemd when ready (sd_notify support)
NotifyAccess=all

# Restart policy
Restart=on-failure
RestartSec=5

# Watchdog — the binary sends WATCHDOG=1 every 10 seconds.
# If no heartbeat is received within 30s, systemd restarts the service.
WatchdogSec=30

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp/picast /var/lib/picast /etc/picast
PrivateTmp=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=true

# Resource limits
LimitNOFILE=4096
CPUWeight=80
IOWeight=80

[Install]
WantedBy=multi-user.target
