[Unit]
Description=boGDan Media Receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=bogdan
Group=bogdan
SupplementaryGroups=video render audio

# Release the kernel framebuffer console (fbcon) from the vc4 DRM
# device so that boGDan (and kmssink) can acquire DRM master.
# On Raspberry Pi with vc4, fbcon binds to the DRM device and holds
# DRM master, preventing other processes from acquiring it.  drmSetMaster
# returns EBUSY even with CAP_SYS_ADMIN in current Linux kernels (6.x),
# so the only way to release master is to unbind fbcon first.
# The "+" prefix runs this as root (overriding User=bogdan) because
# writing to /sys/class/vtconsole requires root even with CAP_SYS_ADMIN.
# The "-" prefix makes failure non-fatal (e.g. on vkms or systems
# without fbcon).
ExecStartPre=+-/bin/sh -c 'for vt in /sys/class/vtconsole/vtcon*/bind; do [ -f "$vt" ] && echo 0 > "$vt" 2>/dev/null; done; true'

# CAP_SYS_ADMIN is kept for potential future use (e.g. DRM auth
# magic).  It does NOT allow stealing DRM master from the console —
# that requires unbinding fbcon via ExecStartPre above.
AmbientCapabilities=CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_SYS_ADMIN

Environment=RUST_LOG=bogdan=info
Environment=HOME=/var/lib/bogdan
Environment=XDG_CACHE_HOME=/var/lib/bogdan/.cache
Environment=BOGDAN_RUNTIME_DIR=/run/bogdan
Environment=TMPDIR=/run/bogdan
# GStreamer debug for diagnosing preroll/playback and caps negotiation failures.
# kmssink:5 = DEBUG (DRM master, plane selection, buffer rendering)
# v4l2h264dec:5 = DEBUG (HW decode caps negotiation)
# h264parse:5 = DEBUG (H.264 stream parsing and output caps)
# GST_CAPS:5 = DEBUG (caps negotiation between elements — critical for not-negotiated errors)
# GST_PADS:4 = INFO (pad linking and data flow)
# GST_STATES:5 = DEBUG (state change transitions)
# souphttpsrc:3 = FIXME (HTTP errors like 403)
Environment=GST_DEBUG=kmssink:5,v4l2h264dec:5,h264parse:5,GST_CAPS:5,GST_PADS:4,GST_STATES:5,souphttpsrc:3
Environment=GST_DEBUG_FILE=/run/bogdan/gst-debug.log
ExecStart=/usr/local/bin/bogdan-server --config /etc/bogdan/bogdan.toml
NotifyAccess=all

Restart=on-failure
RestartSec=5
WatchdogSec=30

RuntimeDirectory=bogdan
RuntimeDirectoryMode=0755
StateDirectory=bogdan
StateDirectoryMode=0755

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/bogdan /var/lib/bogdan /etc/bogdan
PrivateTmp=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=true

LimitNOFILE=4096
CPUWeight=80
IOWeight=80

[Install]
WantedBy=multi-user.target
